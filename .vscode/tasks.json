        "${workspaceFolder}/build/RelWithDebInfo/CMakeFiles/ScreenRecorderPlayer.dir/cpp/videoplayer.cpp.obj",
        "${workspaceFolder}/build/RelWithDebInfo/CMakeFiles/ScreenRecorderPlayer.dir/cpp/filemanager.cpp.obj",
        "${workspaceFolder}/build/RelWithDebInfo/CMakeFiles/ScreenRecorderPlayer.dir/cpp/tabmanager.cpp.obj",
        "${workspaceFolder}/bin/ScreenRecorderPlayer.exe"
      ],
      "group": "build"
    },
    {
      "label": "ScreenRecorderPlayer: build (RelWithDebInfo)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}/build/RelWithDebInfo",
        "--target", "ScreenRecorderPlayer",
        "-j8"
      ],
      "options": {
        "env": {
          "PATH": "${config:custom.mingwBase}/bin;${config:custom.qt5Base}/bin;${config:custom.ffmpegBase}/bin;${env:PATH}"
        }
      },
      "group": "build",
      "dependsOn": [
        "ScreenRecorderPlayer: configure (RelWithDebInfo)"
      ]
    },
    {
      "label": "ScreenRecorderPlayer: rebuild (RelWithDebInfo)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ScreenRecorderPlayer: clean (RelWithDebInfo)",
        "ScreenRecorderPlayer: build (RelWithDebInfo)"
      ],
      "group": "build"
    },
