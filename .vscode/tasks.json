{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure (RelWithDebInfo)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build/RelWithDebInfo",
        "-G", "MinGW Makefiles",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DCMAKE_C_COMPILER=${config:custom.mingwBase}/bin/gcc.exe",
        "-DCMAKE_CXX_COMPILER=${config:custom.mingwBase}/bin/g++.exe",
        "-DQt5_DIR=${config:custom.qt5Base}/lib/cmake/Qt5",
        "-DFFMPEG_ROOT=${config:custom.ffmpegBase}"
      ],
      "options": {
        "env": {
          "PATH": "${config:custom.mingwBase}/bin;${config:custom.qt5Base}/bin;${config:custom.ffmpegBase}/bin;${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "cmake: clean (RelWithDebInfo)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}/build/RelWithDebInfo",
        "--target", "clean"
      ],
      "group": "build"
    },
    {
      "label": "cmake: build (RelWithDebInfo)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}/build/RelWithDebInfo",
        "-j8"
      ],
      "group": "build",
      "dependsOn": [
        "cmake: configure (RelWithDebInfo)"
      ]
    },
    {
      "label": "cmake: clean rebuild (RelWithDebInfo)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "cmake: clean (RelWithDebInfo)",
        "cmake: build (RelWithDebInfo)"
      ]
    },
    {
      "label": "cmake: configure (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build/Release",
        "-G", "MinGW Makefiles",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_C_COMPILER=${config:custom.mingwBase}/bin/gcc.exe",
        "-DCMAKE_CXX_COMPILER=${config:custom.mingwBase}/bin/g++.exe",
        "-DQt5_DIR=${config:custom.qt5Base}/lib/cmake/Qt5",
        "-DFFMPEG_ROOT=${config:custom.ffmpegBase}"
      ],
      "options": {
        "env": {
          "PATH": "${config:custom.mingwBase}/bin;${config:custom.qt5Base}/bin;${config:custom.ffmpegBase}/bin;${env:PATH}"
        }
      },
      "group": "build"
    },
    {
      "label": "cmake: clean (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}/build/Release",
        "--target", "clean"
      ],
      "group": "build"
    },
    {
      "label": "cmake: build (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}/build/Release",
        "-j8"
      ],
      "group": "build",
      "dependsOn": [
        "cmake: configure (Release)"
      ]
    },
    {
      "label": "cmake: clean rebuild (Release)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "cmake: clean (Release)",
        "cmake: build (Release)"
      ]
    },
    {
      "label": "ScreenRecorderPlayer: configure (RelWithDebInfo)",
