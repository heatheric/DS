        "${workspaceFolder}/build/RelWithDebInfo/CMakeFiles/ScreenRecorderPlayer.dir/cpp/main.cpp.obj",
        "${workspaceFolder}/build/RelWithDebInfo/CMakeFiles/ScreenRecorderPlayer.dir/cpp/mainwindow.cpp.obj",
        "${workspaceFolder}/build/RelWithDebInfo/CMakeFiles/ScreenRecorderPlayer.dir/cpp/recordwidget.cpp.obj",
