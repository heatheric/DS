{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 ScreenRecorderPlayer (Release)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/ScreenRecorderPlayer.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "D:/Program/mingw64_gcc12/bin;D:/Program/ffmpeg/bin;X:/Qt/5.15.13/gcc12/bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/Program/mingw64_gcc12/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "构建项目 (Release)",
      "logging": {
        "moduleLoad": false,
        "engineLogging": false
      }
    },
